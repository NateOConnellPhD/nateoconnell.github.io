# Hosting environment variables, never browser variables. Do not put real values in Git.
APP_ORIGIN=https://YOUR-EDITOR.vercel.app
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Your numeric GitHub account ID, not username. Sign-in is restricted to this ID.
ALLOWED_GITHUB_USER_ID=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Must be PRIVATE, owned by NateOConnellPhD, and initialized with a README.
DRAFT_REPOSITORY=NateOConnellPhD/nateoconnell-editor-private
OPENAI_API_KEY=
# Whole-project chat (Responses with direct file tools; shell only on demand).
OPENAI_AGENT_MODEL=gpt-6-astra
# Direct chat defaults to low effort; execution uses medium effort.
OPENAI_CHAT_REASONING_EFFORT=low
# Shared across all model continuations of one message, including execution.
MAX_CHAT_MODEL_STEPS=8
MAX_CHAT_OUTPUT_TOKENS=12000
# Optional shell network hosts, also allowed by your OpenAI organization.
# Leave empty for chat/source editing without outbound shell networking.
OPENAI_SHELL_ALLOWED_DOMAINS=
# Optional writing assistant inside individual content drafts (Responses API).
OPENAI_MODEL=gpt-5.4-mini
MAX_DAILY_AI_REQUESTS=40
