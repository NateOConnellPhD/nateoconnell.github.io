{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "buildCommand": "",
  "installCommand": "npm install --ignore-scripts --no-audit --no-fund",
  "functions": { "api/index.js": { "maxDuration": 120 } },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api?route=:path*" }],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "Cache-Control", "value": "no-store" },
    { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://nateoconnell.com; connect-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'" }
  ]}]
}
